# Scoped API key for POST http://127.0.0.1:7331/secret (no Touch ID per request).
# Issue with: abra keys new my-agent -p myproject
ABRA_KEY=

# Restrict CORS for browser dapps calling the local API (optional).
# ABRA_API_ORIGIN=https://localhost:5173

# Skip Touch ID in dev/test only — never set in production.
# ABRA_SKIP_BIOMETRICS=1
