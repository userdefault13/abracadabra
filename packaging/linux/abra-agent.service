# abra-agent — per-user systemd user unit (Linux)
#
# Holds the unlocked vault master key in memory with idle lock so CLI commands
# do not re-read a login-unlocked Secret Service / keyring on every call.
#
# Install (user session):
#   mkdir -p ~/.config/systemd/user
#   cp packaging/linux/abra-agent.service ~/.config/systemd/user/
#   # Edit ExecStart to absolute paths for node + dist/agent/server.js
#   systemctl --user daemon-reload
#   systemctl --user enable --now abra-agent
#
# ExecStart MUST use absolute paths. Do not rely on mise/nvm/fnm PATH in the
# user manager environment. Examples:
#   ExecStart=/usr/bin/node /usr/lib/abracadabra/dist/agent/server.js
#   ExecStart=/usr/bin/node /home/YOU/.local/lib/node_modules/@userdefault/abracadabra/dist/agent/server.js
# Or drop-in: systemctl --user edit abra-agent
#
# Socket: $XDG_RUNTIME_DIR/abra/agent.sock (mode 0600; dir 0700 via RuntimeDirectory).
# Env: ABRA_AGENT_IDLE_SECONDS (default 900). ABRA_AGENT_MAX_AGE_SECONDS (default
# 28800 = 8h, clamped). ABRA_AGENT=0 disables client use.
#
# Passphrase-file keystore (headless / SSH): uncomment so the agent matches the
# CLI. Unlock with `abra unlock` on a terminal — the CLI pushes the key via
# unlock.key; the agent never prompts.
# Environment=ABRA_KEYSTORE=passphrase-file
#
# Sleep lock: agent spawns /usr/bin/gdbus (or /usr/bin/dbus-monitor) to watch
# logind PrepareForSleep. RestrictAddressFamilies=AF_UNIX allows that (system
# bus is AF_UNIX). No SystemCallFilter is set — do not add one that blocks
# execve of /usr/bin/gdbus. Logind inhibitor is NOT taken (best-effort lock).
#
# Node has no process.setrlimit — LimitCORE=0 is the practical core-dump guard.
# Do NOT set MemoryDenyWriteExecute=yes — V8 JIT needs writable+executable pages.
#
# NOTE (user units): ProtectSystem / ProtectHome / PrivateTmp rely on unprivileged
# user namespaces (systemd implies PrivateUsers for the user manager). Verify live
# on the target distro. Secret Service D-Bus must still work — the session bus
# socket at %t/bus remains connectable even when that mount is read-only.

[Unit]
Description=abracadabra vault agent (idle-locked master key)
Documentation=https://github.com/userdefault13/abracadabra/blob/main/docs/CROSS-PLATFORM.md
After=default.target

[Service]
Type=simple
# EDIT ME — absolute node + absolute path to dist/agent/server.js
ExecStart=/usr/bin/node /usr/lib/abracadabra/dist/agent/server.js
Restart=on-failure
RestartSec=2
UMask=0077

# Runtime dir for the agent socket ($XDG_RUNTIME_DIR/abra = %t/abra).
# Prefer RuntimeDirectory over ReadWritePaths=%t/abra: with ProtectSystem=strict,
# $XDG_RUNTIME_DIR is read-only and ReadWritePaths fails namespace setup if the
# dir does not exist yet. RuntimeDirectory creates it at 0700 for us.
RuntimeDirectory=abra
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no

# Hardening (valid for systemd --user)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Vault lives under ~/.abracadabra — leading '-' means missing path is OK
ReadWritePaths=-%h/.abracadabra
# ProtectHome=read-only would block vault writes unless ReadWritePaths covers
# %h/.abracadabra (included above). Keep read-only home with that exception:
ProtectHome=read-only
LimitCORE=0
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# keytar talks to Secret Service over D-Bus (AF_UNIX). Agent protocol is AF_UNIX.
# AF_INET/AF_INET6 omitted — agent is local-only.
RestrictAddressFamilies=AF_UNIX

# Omitted (incompatible or not for --user without caveats):
# - MemoryDenyWriteExecute — breaks Node/V8 JIT
# - ProtectKernel* / PrivateDevices / RestrictNamespaces — often ineffective
#   or rejected under the user manager; leave to system units if needed

[Install]
WantedBy=default.target
