# abra-agent — per-user systemd user unit (Linux)
#
# Holds the unlocked vault master key in memory with idle lock so CLI commands
# do not re-read a login-unlocked Secret Service / keyring on every call.
#
# Install (user session):
#   mkdir -p ~/.config/systemd/user
#   cp packaging/linux/abra-agent.service ~/.config/systemd/user/
#   # Edit ExecStart to absolute paths for node + dist/agent/server.js
#   systemctl --user daemon-reload
#   systemctl --user enable --now abra-agent
#
# ExecStart MUST use absolute paths. Do not rely on mise/nvm/fnm PATH in the
# user manager environment. Examples:
#   ExecStart=/usr/bin/node /usr/lib/abracadabra/dist/agent/server.js
#   ExecStart=/usr/bin/node /home/YOU/.local/lib/node_modules/@userdefault/abracadabra/dist/agent/server.js
# Or drop-in: systemctl --user edit abra-agent
#
# Socket: $XDG_RUNTIME_DIR/abra/agent.sock (mode 0600; dir 0700).
# Env: ABRA_AGENT_IDLE_SECONDS (default 900). ABRA_AGENT=0 disables client use.
#
# Node has no process.setrlimit — LimitCORE=0 is the practical core-dump guard.
# Do NOT set MemoryDenyWriteExecute=yes — V8 JIT needs writable+executable pages.

[Unit]
Description=abracadabra vault agent (idle-locked master key)
Documentation=https://github.com/userdefault13/abracadabra/blob/main/docs/CROSS-PLATFORM.md
After=default.target

[Service]
Type=simple
# EDIT ME — absolute node + absolute path to dist/agent/server.js
ExecStart=/usr/bin/node /usr/lib/abracadabra/dist/agent/server.js
Restart=on-failure
RestartSec=2
UMask=0077

# Hardening (valid for systemd --user)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Vault lives under ~/.abracadabra; socket under $XDG_RUNTIME_DIR/abra (%t)
ReadWritePaths=%h/.abracadabra %t/abra
# ProtectHome=read-only would block vault writes unless ReadWritePaths covers
# %h/.abracadabra (included above). Keep read-only home with that exception:
ProtectHome=read-only
LimitCORE=0
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# keytar talks to Secret Service over D-Bus (AF_UNIX). Agent protocol is AF_UNIX.
# AF_INET/AF_INET6 omitted — agent is local-only.
RestrictAddressFamilies=AF_UNIX

# Omitted (incompatible or not for --user without caveats):
# - MemoryDenyWriteExecute — breaks Node/V8 JIT
# - ProtectKernel* / PrivateDevices / RestrictNamespaces — often ineffective
#   or rejected under the user manager; leave to system units if needed

[Install]
WantedBy=default.target
